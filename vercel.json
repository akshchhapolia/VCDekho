{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/investors/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=86400, stale-while-revalidate=604800" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/people/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800" },
        { "key": "CDN-Cache-Control", "value": "public, s-maxage=86400, stale-while-revalidate=604800" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/blog/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/waitlist",
      "destination": "/login",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/news/:slug",
      "destination": "/api/news/article?slug=:slug"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/news/article?slug=:slug"
    },
    {
      "source": "/investors/stages/:slug",
      "destination": "/api/investors/detail?slug=:slug&view=stage"
    },
    {
      "source": "/investors/themes/:slug",
      "destination": "/api/investors/detail?slug=:slug&view=theme"
    },
    {
      "source": "/investors/sectors/:slug",
      "destination": "/api/investors/detail?slug=:slug&view=sector"
    },
    {
      "source": "/investors/:slug",
      "destination": "/api/investors/detail?slug=:slug"
    },
    {
      "source": "/people/:slug",
      "destination": "/api/people?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/scrape",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/ai-process",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/scrape",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron/ai-process",
      "schedule": "10 13 * * *"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "40 13 * * *"
    },
    {
      "path": "/api/cron/ai-blog",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/investor-activity?job=news",
      "schedule": "45 6 * * *"
    },
    {
      "path": "/api/cron/investor-activity?job=news",
      "schedule": "25 13 * * *"
    },
    {
      "path": "/api/cron/investor-activity?job=backfill",
      "schedule": "15 14 * * *"
    }
  ]
}
