{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/news/:slug",
      "destination": "/api/news/article?slug=:slug"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/news/article?slug=:slug"
    },
    {
      "source": "/investors/themes/:slug",
      "destination": "/api/investors/theme-detail?slug=:slug"
    },
    {
      "source": "/investors/:slug",
      "destination": "/api/investors/detail?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/scrape",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/ai-process",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/scrape",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron/ai-process",
      "schedule": "10 13 * * *"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "40 13 * * *"
    },
    {
      "path": "/api/cron/ai-blog",
      "schedule": "0 14 * * *"
    }
  ]
}
